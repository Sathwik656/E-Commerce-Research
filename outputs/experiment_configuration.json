{
  "model": "RandomForestRegressor",
  "n_estimators": 300,
  "random_state": 42,
  "split": {
    "train_observations": 1300,
    "test_observations": 1820,
    "train_customers": 1178,
    "test_customers": 1685,
    "customer_overlap": 62,
    "split": "temporal (order date < 2018-01-01)"
  },
  "features": [
    "Recency",
    "PreviousOrderCount",
    "HistoricalSpending",
    "TotalItems",
    "TotalProducts",
    "TotalSellers",
    "AverageOrderValue",
    "AverageFreightValue",
    "AverageInstallments"
  ],
  "target": "NextOrderSpending",
  "target_units": "BRL (Brazilian Real)",
  "metrics": {
    "MAE": 93.897986,
    "RMSE": 150.164308,
    "R2": 0.042581,
    "Median_AE": 60.520345
  },
  "verification": {
    "model_path": "models/spending_model.pkl",
    "features_path": "models/spending_features.json",
    "predictions_identical": true,
    "model_type": "RandomForestRegressor",
    "n_features": 9
  }
}